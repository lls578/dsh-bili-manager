{
  "name": "dsh-bili-manager",
  "version": "0.1.0",
  "description": "DSH 插件：B站 账号运营工具箱 —— 读创作中心数据 / 回评论 / 置顶评论 / 发弹幕",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lls578/dsh-bili-manager.git"
  },
  "homepage": "https://github.com/lls578/dsh-bili-manager#readme",
  "bugs": {
    "url": "https://github.com/lls578/dsh-bili-manager/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check lib/bili.mjs && node --check selftest.mjs && node --check test/plugin.test.mjs",
    "test": "node selftest.mjs",
    "test:plugin": "node test/plugin.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "bili-manager"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "selftest.mjs",
    "test",
    "SECURITY.md"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
